			meta("Throws", ":throws", "Adds a `throws` declaration to the generated function.", [Platforms(["java"]), Params(["Type as String"]), Targets(["TClassField"])]),
			meta("This", ":this", "Internally used to pass a `this` expression to macros.", [Targets(["TExpr"]), Internal]),
			meta("To", ":to", "Specifies that the field of the abstract is a cast operation to the type identified in the function.", [Targets(["TAbstractField"]), Links(["https://haxe.org/manual/types-abstract-implicit-casts.html"])]),
			meta("ToString", ":toString", "Internally used.", [Internal]),
			meta("Transient", ":transient", "Adds the `transient` flag to the class field.", [Platforms(["java"]), Targets(["TClassField"])]),
			meta("Transitive", ":transitive", "Allows transitive casts with an abstract.", [Targets(["TAbstract"])]),
			meta("ValueUsed", ":valueUsed", "Internally used by DCE to mark an abstract value as used.", [Internal]),
			meta("Volatile", ":volatile", "", [Platforms(["java", "cs"])]),
			meta("UnifyMinDynamic", ":unifyMinDynamic", "Allows a collection of types to unify to `Dynamic`.", [Targets(["TClassField"])]),
			meta("Unreflective", ":unreflective", "", [Platforms(["cpp"])]),
			meta("Unsafe", ":unsafe", "Declares a class, or a method with the C#'s `unsafe` flag.", [Platforms(["cs"]), Targets(["TClass", "TClassField"])]),
			meta("Used", ":used", "Internally used by DCE to mark a class or field as used.", [Internal]),
			meta("Using", ":using", "Automatically uses the argument types as static extensions for the annotated type.", [Targets(["TClass", "TEnum", "TAbstract"]), Links(["https://haxe.org/manual/lf-static-extension-metadata.html"])]),
			meta("Value", ":value", "Used to store default values for fields and function arguments.", [Targets(["TClassField"]), Internal]),
			meta("HaxeArguments", ":haxe.arguments", "Used to store function arguments.", [Targets(["TClassField"]), Internal]),
			meta("HaxeWarning", ":haxe.warning", "Modifies warning options, equivalent to the -w CLI argument", [Targets(["TClass", "TClassField"])]),
			meta("Void", ":void", "Use Cpp native `void` return type.", [Platforms(["cpp"])]),
			meta("NeedsExceptionStack", ":needsExceptionStack", "Internally used for some of auto-generated `catch` vars", [Internal]),
			meta("WrappedException", ":wrappedException", "Internally used for exceptions wrapping in `throw` expressions.", [Internal]),
			meta("NativeArrayAccess", ":nativeArrayAccess", "When used on an extern class which implements haxe.ArrayAccess native array access syntax will be generated", [Platforms(["cpp"])])
		];
	}

	static inline function meta(name:String, tag:String, doc:String, props:Array<RegistryProp>):RegistryEntry
		return {name: name, tag: tag, doc: doc, props: props};
}

// One metadata or define the compiler knows. `tag` is what a user writes: `:keep`, `analyzer-optimize`.
typedef RegistryEntry = {
	name:String,
	tag:String,
	doc:String,
	props:Array<RegistryProp>
}

enum RegistryProp {
	// The arguments it takes.
	Params(names:Array<String>);
	// The targets it applies to.
	Platforms(names:Array<String>);
	// The declarations it may be placed on.
	Targets(names:Array<String>);
	// Manual pages about it.
	Links(urls:Array<String>);
	// Set by the compiler itself, not by users.
	Internal;
	// Not to be set by users.
	Reserved;
	// No longer used; the reason.
	Deprecated(reason:String);
}
