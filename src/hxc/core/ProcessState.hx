package hxc.core;

/**
	The statics whose value in a fresh process comes from no initializer (none, or `= null`). A host that runs
	the compiler's main again in the same process (a wasm instance re-entered with callMain) re-runs every
	static initializer but keeps these, and a compilation left in them stays reachable: Compiler.main resets
	them on re-entry. Generated by tools/gen_processstate.py; rerun it when such a static is added.
**/
@:access(hxc.Compiler)
@:access(hxc.context.Context)
@:access(hxc.context.DisplayException)
@:access(hxc.context.DisplayJson)
@:access(hxc.context.MetaRegistry)
@:access(hxc.context.ModuleLoader)
@:access(hxc.context.Retyper)
@:access(hxc.core.Globals)
@:access(hxc.core.TypeFunctions)
@:access(hxc.core.TypeUnification)
@:access(hxc.debug.DebugDump)
@:access(hxc.debug.HeapCensus)
@:access(hxc.eval.EvalContext)
@:access(hxc.eval.EvalMacro)
@:access(hxc.eval.EvalStdLib)
@:access(hxc.generators.GenJS)
@:access(hxc.hxia.CapabilityMask)
@:access(hxc.parser.Parser)
@:access(hxc.typing.ExprPreprocessing)
@:access(hxc.typing.Inline)
@:access(hxc.typing.PatternMaker)
@:access(hxc.typing.TypeFields)
@:access(hxc.typing.Typeload)
@:access(hxc.typing.Typer)
#if emscripten
@:cppFileCode("#include <emscripten/stack.h>
#include <stdlib.h>
#include <string.h>
static void hxc_clear_stack(char *top) { char *lo = (char *)emscripten_stack_get_end(); if (top > lo) memset(lo, 0, top - lo); }
static void hxc_clear_stack_and_exit(int code) { hxc_clear_stack((char *)emscripten_stack_get_base()); exit(code); }")
#end
