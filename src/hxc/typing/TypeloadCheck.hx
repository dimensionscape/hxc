package hxc.typing;

import hxc.ast.Position;
import hxc.ast.Ast;
import hxc.core.NotFound;
import hxc.core.Type;
import hxc.core.TypeFunctions;
import hxc.core.TypeUnification.UnifyError;
import hxc.context.Context;
import hxc.filters.InterfaceCheck;

// Checks class method redefinitions.
class TypeloadCheck {
	// The @:native string argument, with its own position.
	static function getNativeName(meta:Metadata):Null<{name:String, pos:Position}> {
		for (m in meta) if (m.name == ":native") switch (m.params) {
			case [{expr: EConst(CString(s, _)), pos: p}]: return {name: s, pos: p};
			case _: return null;
		}
		return null;
	}

	// An override must carry the same @:native value as its base (a base without one counts as
	// different).
	static function checkNativeNameOverride(ctx:Context, child:TClassField, base:TClassField):Void {
		var cn = getNativeName(child.meta);
		if (cn == null) return;
		var bn = getNativeName(base.meta);
		var basePos = bn == null ? base.namePos : bn.pos;
		if (bn != null && bn.name == cn.name) return;
		ctx.addDiagnostic("Field " + child.name + " has different @:native value than in superclass", cn.pos);
		ctx.addDiagnostic("... Base field is defined here", basePos, 1);
	}

	// checkOverriding runs per DECLARATION and resolves by name, so for merged overloads the same
	// field is checked more than once. The abstract-parent branch ADDS CfOverride when the child does
	// not carry it, so a later check would see that flag and report it as if the user had written
	// `override` ("declared 'override' but parent field is 'abstract'" on a class that says no such
	// thing). The flags this synthesis added are remembered so they are never reported.
	static var autoOverride:haxe.ds.ObjectMap<TClassField, Bool> = new haxe.ds.ObjectMap();

	// Per-request reset for the wait server, matching TypeFields.resetPerRequest.
	public static function resetPerRequest():Void {
		autoOverride = new haxe.ds.ObjectMap();
	}

	// The final fields without an initializer of the class (and of each abstract superclass that has no
	// constructor anywhere up its chain) must each be assigned in the constructor body.
	public static function checkFinalVars(ctx:Context, curclass:TClass, e:TExpr):Void {
		var finalVars = new Map<String, Bool>();
		var orderedFields:Array<TClassField> = [];
		function loop(c:TClass):Void {
			for (cf in c.orderedFields) switch (cf.kind) {
				case Var(_) if (TypeFunctions.hasClassFieldFlag(cf, CfFinal) && cf.expr == null && !finalVars.exists(cf.name)):
					finalVars.set(cf.name, false);
					orderedFields.push(cf);
				case _:
			}
			var sup = c.superClass;
			if (sup != null && TypeFunctions.hasClassFlag(sup.c, CAbstract) && !TypeFunctions.hasConstructor(sup.c)) loop(sup.c);
		}
		loop(curclass);
		if (!finalVars.keys().hasNext()) return;
		function findInits(e:TExpr):Void {
			switch (e.expr) {
				case TBinop(OpAssign, {expr: TField({expr: TConst(TThis)}, fa)}, e2):
					finalVars.remove(TypeFunctions.fieldName(fa));
					findInits(e2);
				case _:
					hxc.core.TexprTools.iter(findInits, e);
			}
		}
		findInits(e);
		if (finalVars.keys().hasNext())
			ctx.addDiagnostic("Some final fields are uninitialized in this class", curclass.namePos);
		for (cf in orderedFields) if (finalVars.exists(cf.name))
			ctx.addDiagnostic("Uninitialized field", cf.namePos, 1);
	}

	// Structural equality on two field kinds.
	static function sameKind(a:FieldKind, b:FieldKind):Bool {
		return switch [a, b] {
			case [Method(m1), Method(m2)]: m1 == m2;
			case [Var(v1), Var(v2)]: std.Type.enumEq(v1.read, v2.read) && std.Type.enumEq(v1.write, v2.write);
			case _: false;
		};
	}

	// Every field of the class's ancestors (an interface's super-interfaces), excluding the class itself:
	// the nearest declaration of each name.
	static function allSuperFields(c0:TClass):Map<String, TClassField> {
		var acc = new Map<String, TClassField>();
		function loop(c:TClass):Void {
			if (c != c0) for (cf in c.orderedFields) if (!acc.exists(cf.name)) acc.set(cf.name, cf);
			if (TypeFunctions.hasClassFlag(c, CInterface)) {
				for (i in c.interfaces) loop(i.c);
			} else if (c.superClass != null) loop(c.superClass.c);
		}
		loop(c0);
		return acc;
	}

	// Checks a method against the superclass field it redefines; an `overload` field and each of its
	// overloads against the inherited overload of the same signature.
	public static function checkOverriding(ctx:Context, c:TClass, f:TClassField):Void {
		var sup = c.superClass;
		if (sup == null) {
			if (TypeFunctions.hasClassFieldFlag(f, CfOverride))
				ctx.addDiagnostic("Field " + f.name + " is declared 'override' but doesn't override any field", f.pos);
			return;
		}
		// Classes generated by -net-lib are not checked.
		if (TypeFunctions.hasClassFlag(c, CExtern) && TypeFunctions.hasMeta(":cs.native", c.meta)) return;
		var csup = sup.c, params = sup.params;
		var p = f.namePos;
		var i = f.name;
		function checkField(f:TClassField, getSuperField:(TClass, String) -> {t:T, f:TClassField}, isOverload:Bool):Void {
			try {
				if (isOverload && !TypeFunctions.hasClassFieldFlag(f, CfOverload))
					ctx.addDiagnostic("Missing overload declaration for field " + i, p);
				var fHasOverride = TypeFunctions.hasClassFieldFlag(f, CfOverride);
				var sf = getSuperField(csup, i);
				var t = sf.t, f2 = sf.f;
				checkNativeNameOverride(ctx, f, f2);
				// Allow to define fields that are not defined for this platform version in superclass
				switch (f2.kind) {
					case Var({read: AccRequire(_, _)}): throw new NotFound("field not available on this platform");
					case _:
				}
				if (TypeFunctions.hasClassFieldFlag(f2, CfAbstract)) {
					if (fHasOverride && !autoOverride.exists(f))
						ctx.addDiagnostic("Field " + i + " is declared 'override' but parent field " + i + " is 'abstract' and does not provide any implementation to override", p);
					else if (!fHasOverride) {
						TypeFunctions.addClassFieldFlag(f, CfOverride);
						autoOverride.set(f, true);
					}
				}
				if (TypeFunctions.hasClassFieldFlag(f2, CfOverload) && !TypeFunctions.hasClassFieldFlag(f, CfOverload))
					ctx.addDiagnostic("Field " + i + " should be declared with overload since it was already declared as overload in superclass", p);
				else if (!fHasOverride && !TypeFunctions.hasClassFieldFlag(f2, CfAbstract)) {
					if (TypeFunctions.hasClassFlag(c, CExtern))
						TypeFunctions.addClassFieldFlag(f, CfOverride);
					else
						ctx.addDiagnostic("Field " + i + " should be declared with 'override' since it is inherited from superclass " + Context.sTypePath(csup.path), p);
				} else if (!TypeFunctions.hasClassFieldFlag(f, CfPublic) && TypeFunctions.hasClassFieldFlag(f2, CfPublic))
					ctx.addDiagnostic("Field " + i + " has less visibility (public/private) than superclass one", p);
				else switch [f.kind, f2.kind] {
					case [_, Method(MethInline)]:
						ctx.addDiagnostic("Field " + i + " is inlined and cannot be overridden", p);
					case [a, b] if (sameKind(a, b)):
					case [Method(MethInline), Method(MethNormal)]:
						// Allow to redefine a method as inlined
					case _:
						ctx.addDiagnostic("Field " + i + " has different property access than in superclass", p);
				}
				if (TypeFunctions.hasClassFieldFlag(f2, CfFinal)) ctx.addDiagnostic("Cannot override final method " + i, p);
				try {
					var t2 = TypeFunctions.applyParams(csup.params, params, t);
					var map = TypeFunctions.classMapFunction(csup, params);
					InterfaceCheck.validRedefinition(map, map, f, f.type, f2, t2);
				} catch (e:UnifyError) {
					ctx.addDiagnostic("Field " + i + " overrides parent class with different or incomplete type", p);
					ctx.addDiagnostic("... Base field is defined here", f2.namePos, 1);
					ctx.addDiagnostic("... " + hxc.core.TPrinting.betterErrorMessage(e.errors), p, 1);
				}
			} catch (_:NotFound) {
				if (TypeFunctions.hasClassFieldFlag(f, CfOverride)) {
					var msg = if (isOverload) {
						"Field " + i + " is declared 'override' but no compatible overload was found";
					} else {
						// The names are visited in key order and each is prepended to the list.
						var fields = allSuperFields(c);
						var keys = [for (k in fields.keys()) k];
						hxc.core.StringSort.sort(keys);
						var names:Array<String> = [];
						for (k in keys) {
							var cf = fields.get(k);
							switch (cf.kind) {
								case Method(MethNormal) if (!TypeFunctions.hasClassFieldFlag(cf, CfFinal)): names.unshift(cf.name);
								case _:
							}
						}
						hxc.core.StringError.stringError(i, names, "Field " + i + " is declared 'override' but doesn't override any field");
					};
					ctx.addDiagnostic(msg, p);
				}
			}
		}
		if (TypeFunctions.hasClassFieldFlag(f, CfOverload)) {
			var overloads = Overloads.getOverloads(ctx, csup, i);
			// Check if any super class fields are vars
			for (o in overloads) switch (o.cf.kind) {
				case Var(_): ctx.addDiagnostic("A variable named '" + o.cf.name + "' was already declared in a superclass", f.pos);
				case _:
			}
			for (f in [f].concat(f.overloads))
				// Find the exact field being overridden
				checkField(f, function(csup:TClass, _:String) {
					for (o in overloads)
						if (Overloads.sameOverloadArgs(f.type, TypeFunctions.applyParams(csup.params, params, o.t), f, o.cf))
							return {t: o.t, f: o.cf};
					throw new NotFound("no overridden overload");
				}, true);
		} else {
			checkField(f, function(csup:TClass, i:String) {
				var r = TypeFunctions.rawClassField(function(f) return f.type, csup, params, i);
				return {t: r.t, f: r.f};
			}, false);
		}
	}
}
